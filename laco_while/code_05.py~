def contarPrimos(num1, num2):

    if(num1>num2):

        aux = num2
        num2 = num1
        num1 = aux

    if(num1<=0):
        return -1 #Indica erro ao receber numeros negativos ou o numero zero

    contagemPrimos = 0
    contagemDivisores = 0
    divisor = 1

    while (num1<=num2):

        while(divisor<=num1):

            if(num1%divisor == 0):

                contagemDivisores = contagemDivisores + 1
            
            divisor = divisor + 1

        if(contagemDivisores == 2):
            contagemPrimos = contagemPrimos + 1
        
        """Para a proxima interacao envolvendo o proximo numero, devemos resetar os valores de 
            os valores de divisor e contagemDivisores para o valor inicial deles tal como definimos anteriormente    
        """
        contagemDivisores = 0
        divisor = 1

        num1 = num1 + 1

    return contagemPrimos

print(contarPrimos(-6,0))
print(contarPrimos(2,-1))
print(contarPrimos(1,1))
print(contarPrimos(3,9))
print(contarPrimos(7,3))
print(contarPrimos(1,20))
