def divisoresComuns(num1,num2):

    if(num1 > num2):

        aux = num1
        num1 = num2
        num2 = aux
    
    divisoresComuns = 0
    contagem = 1

    listaDivisoresComuns = []

    while contagem<=num1: #Aqui vamos ate o valor de num1, porque calculamos os divisores ate o valor de num1 ser alcancado

        if(num1 % contagem == 0) and (num2 % contagem == 0):
            
            divisoresComuns = divisoresComuns + 1
            listaDivisoresComuns = listaDivisoresComuns + [contagem]
        contagem = contagem + 1

    return divisoresComuns, listaDivisoresComuns 
"""
A funcao acima vai retornar uma tupla com o primeiro elemento sendo a quantidade de divisores e o segundo a lista
de divisores em comuns
"""

print(divisoresComuns(2,10))
print(divisoresComuns(10,2))
print(divisoresComuns(5,10))
print(divisoresComuns(8,4))
print(divisoresComuns(10,12))
print(divisoresComuns(24,32))
print(divisoresComuns(32,24))



        

